using Gtk 4.0;
using Gdk 4.0;
using Adw 1;
using GObject 2.0;

$GameActions game_actions {
  game: bind template.game;
}

$CollectionActions collection_actions {
  game: bind template.game;
}

$GameEditable game_editable {
  game: bind template.game;
  executable: bind executable_entry.text;
  name: bind name_entry.text;
  developer: bind developer_entry.text;
}

GObject.SignalGroup game_signals {
  target: bind template.game;
  target-type: typeof<$Game>;
}

template $GameDetails: Adw.NavigationPage {
  name: "details";
  tag: "details";
  title: bind try { template.game as <$Game>.name, _("Add Game") };
  hidden => $_cancel();

  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(details.cancel)";
    }

    Shortcut {
      trigger: "Delete|KP_Delete";
      action: "action(game.remove)";
    }
  }

  child: Adw.BreakpointBin {
    width-request: bind template.root as <Widget>.width-request;
    height-request: bind template.root as <Widget>.height-request;

    Adw.Breakpoint {
      condition ("max-width: 700px")

      setters {
        box.orientation: vertical;
        name_label.halign: center;
        name_label.justify: center;
        developer_label.halign: center;
        developer_label.justify: center;
        date_labels.orientation: vertical;
        date_labels.halign: center;
        last_played_label.halign: center;
        last_played_label.justify: center;
        added_label.halign: center;
        added_label.justify: center;
        playtime_label.halign: center;
        playtime_label.justify: center;
        actions.orientation: vertical;
        actions.halign: center;
        actions.spacing: 24;
      }
    }

    child: Overlay {
      child: Picture {
        name: "background";
        paintable: bind try { $_downscale(template.game as <$Game>.cover), null };
        content-fit: cover;
      };

      [overlay]
      Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
        }

        content: ScrolledWindow {
          hscrollbar-policy: never;

          child: Box {
            orientation: vertical;
            valign: center;
            margin-bottom: 48;

            Box box {
              halign: center;
              margin-top: 12;
              margin-start: 24;
              margin-end: 24;
              spacing: 36;

              $Cover {
                paintable: bind try { template.game as <$Game>.cover, null } as <Gdk.Paintable>;
              }

              Adw.ViewStack stack {
                vhomogeneous: false;
                enable-transitions: true;
                visible-child-name: bind $if(template.editing, "edit", "details");

                Adw.ViewStackPage {
                  name: "details";

                  child: Box {
                    orientation: vertical;
                    valign: center;
                    spacing: 6;

                    Label name_label {
                      label: bind template.game as <$Game>.name;
                      halign: start;
                      max-width-chars: 24;
                      wrap: true;
                      wrap-mode: word_char;

                      styles [
                        "title-1",
                      ]
                    }

                    Label developer_label {
                      label: bind template.game as <$Game>.developer;
                      visible: bind $bool(template.game as <$Game>.developer);
                      halign: start;
                      max-width-chars: 36;
                      wrap: true;
                      wrap-mode: word_char;

                      styles [
                        "heading",
                      ]
                    }

                    Box date_labels {
                      halign: start;
                      valign: start;
                      margin-top: 9;
                      spacing: 9;

                      Label last_played_label {
                        label: bind $format(
                          _("Last played: {}"),
                          $_relative_date(template.game as <$Game>.last-played) as <string>
                        );
                        halign: start;
                        wrap: true;
                        wrap-mode: word_char;
                      }

                      Label added_label {
                        label: bind $format(_("Added: {}"), $_relative_date(template.game as <$Game>.added) as <string>);
                        halign: start;
                        wrap: true;
                        wrap-mode: word_char;
                      }

                      Label playtime_label {
                        label: bind $format(_("Playtime: {}"), template.playtime) as <string>;
                        visible: bind $bool(template.playtime) as <bool>;
                        tooltip-text: bind template.playtime-tooltip;
                        halign: start;
                        wrap: true;
                        wrap-mode: word_char;
                      }
                    }

                    Box actions {
                      spacing: 12;
                      margin-top: 15;

                      Button {
                        action-name: "game.play";
                        label: _("Play");
                        valign: center;
                        halign: center;

                        styles [
                          "pill",
                          "suggested-action",
                        ]
                      }

                      Box {
                        spacing: 6;
                        halign: center;

                        Button {
                          action-name: "details.edit";
                          icon-name: "document-edit-symbolic";
                          tooltip-text: _("Edit");
                          valign: center;

                          styles [
                            "circular",
                          ]
                        }

                        MenuButton {
                          icon-name: "collection-symbolic";
                          tooltip-text: _("Collections");
                          valign: center;
                          notify::active => $_setup_collections();

                          popover: PopoverMenu {
                            menu-model: menu {
                              item (_("New Collection"), "collection.add")

                              item {
                                custom: "collections";
                              }
                            };

                            [collections]
                            Box {
                              orientation: vertical;
                              visible: bind collections_box.visible;

                              Separator {}

                              Label {
                                label: _("Collections");
                                halign: start;
                                margin-top: 6;
                                margin-bottom: 9;
                                margin-start: 12;
                                margin-end: 12;

                                styles [
                                  "heading",
                                ]
                              }

                              $CollectionsBox collections_box {
                                game: bind template.game;
                              }
                            }
                          };

                          styles [
                            "circular",
                          ]
                        }

                        Button hide_button {
                          visible: bind hide_button.sensitive;
                          action-name: "game.hide";
                          icon-name: "view-conceal-symbolic";
                          tooltip-text: _("Hide");
                          valign: center;

                          styles [
                            "circular",
                          ]
                        }

                        Button unhide_button {
                          visible: bind unhide_button.sensitive;
                          action-name: "game.unhide";
                          icon-name: "view-reveal-symbolic";
                          tooltip-text: _("Unhide");
                          valign: center;

                          styles [
                            "circular",
                          ]
                        }

                        Button {
                          action-name: "game.remove";
                          icon-name: "user-trash-symbolic";
                          tooltip-text: _("Remove");
                          valign: center;

                          styles [
                            "circular",
                          ]
                        }

                        MenuButton {
                          icon-name: "edit-find-symbolic";
                          tooltip-text: _("Search On");
                          valign: center;

                          menu-model: menu {
                            section {
                              label: _("Search On");

                              item {
                                label: _("HowLongToBeat");
                                action: "details.search-on";
                                target: "https://howlongtobeat.com/?q={}";
                              }

                              item {
                                label: _("IGDB");
                                action: "details.search-on";
                                target: "https://www.igdb.com/search?type=1&q={}";
                              }

                              item {
                                label: _("Lutris");
                                action: "details.search-on";
                                target: "https://lutris.net/games?q={}";
                              }

                              item {
                                label: _("PCGamingWiki");
                                action: "details.search-on";
                                target: "https://www.pcgamingwiki.com/w/index.php?search={}";
                              }

                              item {
                                label: _("ProtonDB");
                                action: "details.search-on";
                                target: "https://www.protondb.com/search?q={}";
                              }

                              item {
                                label: _("SteamGridDB");
                                action: "details.search-on";
                                target: "https://www.steamgriddb.com/search/grids?term={}";
                              }
                            }
                          };

                          styles [
                            "circular",
                          ]
                        }
                      }
                    }
                  };
                }

                Adw.ViewStackPage {
                  name: "edit";

                  child: Box {
                    orientation: vertical;
                    valign: center;
                    width-request: 300;
                    spacing: 24;

                    Adw.PreferencesGroup {
                      Adw.EntryRow name_entry {
                        title: _("Title");
                        text: bind try { template.game as <$Game>.name, "" };
                        entry-activated => $_activate_apply();
                      }

                      Adw.EntryRow developer_entry {
                        title: _("Developer (optional)");
                        text: bind try { template.game as <$Game>.developer, "" };
                        entry-activated => $_activate_apply();
                      }
                    }

                    Adw.PreferencesGroup {
                      Adw.EntryRow executable_entry {
                        title: _("Executable");
                        text: bind try { template.game as <$Game>.executable, "" };
                        entry-activated => $_activate_apply();

                        [suffix]
                        MenuButton {
                          valign: center;
                          tooltip-text: _("More Info");
                          icon-name: "info-outline-symbolic";

                          popover: Popover {
                            child: Label {
                              label: bind $_format_more_info(
                                _(
                                  "To launch the executable \"{}\", use the command:\n\n<tt>\"{}\"</tt>\n\nTo open the file \"{}\" with the default application, use:\n\n<tt>{} \"{}\"</tt>\n\nIf the path contains spaces, make sure to wrap it in double quotes!"
                                )
                              );
                              use-markup: true;
                              wrap: true;
                              wrap-mode: word_char;
                              margin-top: 12;
                              margin-bottom: 12;
                              margin-start: 12;
                              margin-end: 12;
                            };
                          };

                          styles [
                            "flat",
                          ]
                        }
                      }
                    }

                    Adw.WrapBox {
                      halign: center;
                      wrap-reverse: true;
                      justify: fill;
                      justify-last-line: true;
                      child-spacing: 12;
                      line-spacing: 12;

                      Button cancel_button {
                        action-name: "details.cancel";
                        label: _("Cancel");

                        styles [
                          "pill",
                        ]
                      }

                      Button apply_button {
                        action-name: "details.apply";
                        label: bind $if(template.game, _("Apply"), _("Add"));

                        styles [
                          "pill",
                          "suggested-action",
                        ]
                      }
                    }
                  };
                }
              }
            }

            Adw.Spinner {
              visible: bind template.store-loading;
              margin-top: 48;
              width-request: 32;
              height-request: 32;
            }

            Revealer {
              reveal-child: bind template.store-revealed;
              transition-type: slide_down;
              transition-duration: 300;

              child: Adw.Clamp {
                maximum-size: 960;
                tightening-threshold: 600;
                margin-top: 48;
                margin-start: 24;
                margin-end: 24;

                child: Box {
                  name: "store";
                  orientation: vertical;
                  spacing: 24;

                  Box {
                    orientation: vertical;
                    spacing: 12;
                    visible: bind template.has-screenshots;

                    Overlay {
                      child: $AspectBin {
                        child: Adw.Carousel carousel {
                          name: "store-carousel";
                          allow-scroll-wheel: false;
                          page-changed => $_screenshot_changed();
                        };
                      };

                      [overlay]
                      Button {
                        icon-name: "go-previous-symbolic";
                        tooltip-text: _("Previous Screenshot");
                        halign: start;
                        valign: center;
                        margin-start: 12;
                        clicked => $_previous_screenshot();

                        styles [
                          "circular",
                          "osd",
                        ]
                      }

                      [overlay]
                      Button {
                        icon-name: "go-next-symbolic";
                        tooltip-text: _("Next Screenshot");
                        halign: end;
                        valign: center;
                        margin-end: 12;
                        clicked => $_next_screenshot();

                        styles [
                          "circular",
                          "osd",
                        ]
                      }
                    }

                    ScrolledWindow {
                      vscrollbar-policy: never;
                      propagate-natural-height: true;

                      child: Box thumbnails_box {
                        name: "store-thumbnails";
                        halign: center;
                        spacing: 6;
                        margin-bottom: 6;
                      };
                    }
                  }

                  Label short_description_label {
                    name: "store-summary";
                    use-markup: true;
                    wrap: true;
                    wrap-mode: word_char;
                    xalign: 0;
                    visible: bind $bool(short_description_label.label) as <bool>;
                  }

                  Adw.WrapBox genres_box {
                    child-spacing: 6;
                    line-spacing: 6;
                  }

                  Grid info_grid {
                    column-spacing: 18;
                    row-spacing: 6;
                  }

                  Box {
                    orientation: vertical;
                    spacing: 12;
                    visible: bind template.has-achievements;

                    Box {
                      spacing: 12;

                      Label {
                        label: _("Achievements");
                        xalign: 0;
                        hexpand: true;

                        styles [
                          "title-3",
                        ]
                      }

                      Label achievements_label {
                        valign: baseline_center;

                        styles [
                          "dim-label",
                        ]
                      }
                    }

                    ProgressBar achievements_progress {
                      name: "achievements-progress";
                    }

                    ListBox achievements_list {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]
                    }

                    Button {
                      label: bind $if(template.achievements-expanded, _("Show Fewer"), _("Show All Achievements")) as <string>;
                      halign: center;
                      visible: bind template.achievements-long;
                      clicked => $_toggle_achievements();

                      styles [
                        "pill",
                      ]
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 12;
                    visible: bind $bool(about_label.label) as <bool>;

                    Label {
                      label: _("About This Game");
                      xalign: 0;

                      styles [
                        "title-3",
                      ]
                    }

                    Label about_label {
                      use-markup: true;
                      wrap: true;
                      wrap-mode: word_char;
                      xalign: 0;
                    }

                    Button {
                      label: bind $if(template.about-expanded, _("Show Less"), _("Read More")) as <string>;
                      halign: center;
                      visible: bind template.about-long;
                      clicked => $_toggle_about();

                      styles [
                        "pill",
                      ]
                    }
                  }

                  Button {
                    halign: start;
                    visible: bind template.has-store-info;
                    clicked => $_open_store();

                    child: Adw.ButtonContent {
                      label: _("View on Steam");
                      icon-name: "adw-external-link-symbolic";
                    };

                    styles [
                      "flat",
                    ]
                  }
                };
              };
            }
          };
        };
      }
    };
  };
}

SizeGroup {
  widgets [
    cancel_button,
    apply_button,
  ]
}
